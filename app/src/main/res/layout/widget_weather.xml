<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_weather_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textSize="28sp"
            tools:text="☀️" />

        <TextView
            android:id="@+id/widget_weather_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_temp_placeholder"
            android:textColor="@color/widget_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="29°C" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_weather_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="@string/widget_tap_to_refresh_weather"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_weather_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="H: 32° L: 26°"
        tools:visibility="visible" />
</LinearLayout>
